rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(tenantId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/tenants/$(tenantId)).data.memberUids;
    }

    // ── Tenants (multi-tenant root) ──
    match /tenants/{tenantId} {
      // Anyone authenticated may create a tenant they are a member of
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.uid == request.resource.data.ownerUid;
      // Only members may read/update; only the owner may delete
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      // All business data lives in subcollections; members only
      match /{collection}/{docId} {
        allow read, write: if isMember(tenantId);
      }
    }

    // ── Legacy root collections (pre-tenant data) ──
    // Authenticated-only, kept for one-time migration into a tenant.
    // TODO: delete this block after legacy data is removed.
    match /{collection}/{docId} {
      allow read, write: if request.auth != null
        && collection in [
          'categories', 'products', 'tables', 'payments', 'staff', 'roles',
          'cash_movements', 'day_closures', 'stock_items', 'stock_transactions',
          'inventories', 'suppliers', 'happy_hours', 'product_addons', 'settings'
        ];
    }
  }
}
